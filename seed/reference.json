  "tiers": [
    {
      "tier": 1,
      "name": "Low risk, productivity-centric",
      "definition": "Individual / immediate team productivity with low authority, bounded assist/read use cases, reversible outcomes; no write to enterprise source systems; non-sensitive (internal) data; pre-approved tools; no MC data.",
      "examples": "Internal drafting, summarization, search, coding assistance with no sensitive data or actions.",
      "builder_persona": "Citizen user / General end user"
    },
    {
      "tier": 2,
      "name": "Medium risk, advisory, limited action",
      "definition": "Team or department level agents; bounded read/assist, reversible outcomes; non-sensitive data; internal-only approved tools and connectors; no MC data; no write-backs to BC or SOX enterprise systems; limited autonomy within predefined steps.",
      "examples": "RAG over business knowledge, internal workflow recommendations, controlled tool use.",
      "builder_persona": "Citizen user* / Pro-dev"
    },
    {
      "tier": 3,
      "name": "High risk, sensitive, material operational authority/impact",
      "definition": "Enterprise-shared agents supporting operational processes; controlled write access to BC systems (excluding SOX); broader reach (externally facing); workflow execution with human-in-the-loop guardrails; personal sensitive (GDPR) data but no MC.",
      "examples": "Sensitive data, privileged actions, customer/employee impact, automated decision support.",
      "builder_persona": "Pro-dev"
    },
    {
      "tier": 4,
      "name": "Very high risk",
      "definition": "Potential harm to people (e.g. safety systems) or irreversible actions; high autonomy; MC data; external users or safety/financial (e.g. SOX) critical systems; human oversight of every output required.",
      "examples": "Autonomous write actions on systems of record, regulated decisions.",
      "builder_persona": "Pro-dev"
    }
  ],
  "tier_dimensions": [
    "Blast radius – how many users, transactions or decisions one agent error affects",
    "Reversibility – can an error be undone? Irreversible actions need a human write-gate",
    "Regulatory exposure – regulated domain (pricing, credit, consent, energy retail, data residency)?"
  ],
  "tier_questions": [
    {
      "id": "TQ1",
      "text": "Does the agent communicate directly with external parties (customers, regulators, suppliers)?",
      "if_yes": "Tier 3/4"
    },
    {
      "id": "TQ2",
      "text": "Does the agent take autonomous write-actions on systems of record (CRM, ERP, payment, marketing platforms)?",
      "if_yes": "Tier 4 regardless of audience"
    },
    {
      "id": "TQ3",
      "text": "Does the agent operate within a regulated function (pricing, credit eligibility, safety decisions)?",
      "if_yes": "Tier 4 regardless of user base"
    },
    {
      "id": "TQ4",
      "text": "Is the user base internal, trusted and bounded, with outputs advisory rather than authoritative?",
      "if_yes": "Tier 2"
    },
    {
      "id": "TQ5",
      "text": "Is the deployment explicitly time-boxed (<90 days), with <100 users and no autonomous write-actions?",
      "if_yes": "Tier 1/2"
    }
  ],
  "rag_rule": {
    "red": "critical_gaps >= 2 OR min_lens_readiness < 50 OR (critical_gaps >= 1 AND days_to_next_decision <= 7)",
    "amber": "critical_gaps >= 1 OR min_lens_readiness < 70",
    "green": "otherwise"
  },
